# Copy to .env and fill in. Never commit real secrets.
APP_NAME=Customer Operations Agent
APP_ENV=development
LOG_LEVEL=INFO

# Required for /api/v1/tickets, /api/v1/runs, and /api/v1/agent/run.
# GET /health stays public. The process refuses to start when this is empty.
API_KEY=change-me-to-a-long-random-string

# SQLite for the local demo and CI. The file is gitignored.
DATABASE_URL=sqlite:///./data/ops.db
FIXTURES_DIR=data

# heuristic (default, offline) | ollama | openai
# heuristic needs no key and no running model. CI uses this path.
AI_PROVIDER=heuristic
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3

# Optional. When empty, notify_slack logs a metadata line and does not post.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#vision-ops-alerts

# Planner/executor guardrails.
MAX_TOOL_ROUNDS=6
TOOL_MAX_ATTEMPTS=3
TOOL_RETRY_BASE_SECONDS=0.2
# Set true to fail lookup_kb once per run so you can see retry/backoff.
SIMULATE_FLAKY_TOOL=false
ALLOWED_TOOLS=lookup_kb,get_customer,create_ticket,update_ticket,notify_slack

# n8n only. The workflow reads these from the n8n process environment.
# Do not paste them into n8n/vision-ops-ticket-bridge.json.
# Set OPS_AGENT_API_KEY to the same value as API_KEY on the machine that runs n8n.
OPS_AGENT_URL=http://127.0.0.1:8789
OPS_AGENT_API_KEY=
