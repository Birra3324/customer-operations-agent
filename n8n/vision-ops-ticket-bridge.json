{
  "name": "Vision AI Ops ticket bridge",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vision-ops-ticket",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "8f1c2a40-6b2e-4a1d-9c3e-1a0b7e5d4c21",
      "name": "Receive ticket event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "vision-ops-ticket"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OPS_AGENT_URL}}/api/v1/integrations/n8n/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.OPS_AGENT_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'ticket.created', subject: $json.body.subject, body: $json.body.body, customer_id: $json.body.customer_id, channel: $json.body.channel || 'portal', external_id: String($execution.id), workflow: 'vision-ops-ticket-bridge' }) }}",
        "options": {}
      },
      "id": "b7e4d1aa-91c0-4f55-8a66-2c3d4e5f6071",
      "name": "Call agent API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.OPS_AGENT_URL}}/api/v1/integrations/n8n/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.OPS_AGENT_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ticket_id: $json.ticket.id, workflow: $json.workflow, status: 'posted', external_id: $json.external_id, note: 'n8n bridge posted agent status' }) }}",
        "options": {}
      },
      "id": "c90a18de-44b2-4e77-9d10-7f6a5b4c3d82",
      "name": "Post status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Receive ticket event": {
      "main": [
        [
          {
            "node": "Call agent API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call agent API": {
      "main": [
        [
          {
            "node": "Post status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
